# Database
DATABASE_URL=postgresql://axon:password@localhost:5432/axon_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=change_me_in_production_different_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# AWS / S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1
S3_BUCKET_NAME=axon-videos-dev
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@axon.ai

# ML Service
# For distributed setup set this to your RunPod/Lambda public endpoint (example: http://123.45.67.89:8000)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=internal_secret_for_service_auth

# Frontend URL (for CORS + OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Server
PORT=3001
NODE_ENV=development

# Security
COOKIE_DOMAIN=localhost
CSRF_SECRET=replace_with_32_chars

# HuggingFace (for model downloads on cloud GPU)
HF_TOKEN=
# ML runtime profile (full mode for cloud GPU inference node)
ML_PROFILE=full
ML_REQUIRE_FULL_MODELS=true
ML_ENABLE_VJEPA2=true
ML_ENABLE_WAV2VEC=true
ML_ENABLE_LLAMA=true
ML_ENABLE_TRIBE=true
ML_ENABLE_WHISPER=true
TRIBE_MODEL_ID=facebook/tribev2
TRIBE_MODEL_ID_FALLBACK=
VJEPA_MODEL_ID=facebook/vjepa2
VJEPA_MODEL_ID_FALLBACK=
WAV2VEC_MODEL_ID=facebook/w2v-bert-2.0
LLAMA_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
WHISPER_MODEL_SIZE=small

# Vite client
VITE_API_URL=http://localhost:3001/api/v1
VITE_SOCKET_URL=http://localhost:3001
